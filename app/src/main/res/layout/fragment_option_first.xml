<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".OptionFirstFragment"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/option_first_first_tab_cl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <TextView
            android:id="@+id/option_first_first_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="좁은 골목길"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="35dp"
            android:layout_marginStart="50dp"/>

        <ImageView
            android:id="@+id/option_first_one_iv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/img_narrow_street"
            app:layout_constraintTop_toTopOf="@id/option_first_first_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@id/option_first_bar_sb"
            android:layout_marginBottom="13dp"
            android:layout_marginHorizontal="55dp"/>

        <SeekBar
            android:id="@+id/option_first_bar_sb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="60dp"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/option_first_second_tab_cl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <TextView
            android:id="@+id/option_first_second_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="차선 변경"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="35dp"
            android:layout_marginStart="50dp"/>

        <ImageView
            android:id="@+id/option_first_two_iv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/img_change_lane"
            app:layout_constraintTop_toBottomOf="@id/option_first_second_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@id/option_first_two_bar_sb"
            android:layout_marginBottom="13dp"
            android:layout_marginHorizontal="55dp"/>

        <SeekBar
            android:id="@+id/option_first_two_bar_sb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="60dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/option_first_third_tab_cl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <TextView
            android:id="@+id/option_first_third_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="차선 수"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="35dp"
            android:layout_marginStart="50dp"/>

        <ImageView
            android:id="@+id/option_first_three_iv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/img_lane_num"
            app:layout_constraintTop_toBottomOf="@id/option_first_third_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@id/option_first_three_bar_sb"
            android:layout_marginBottom="13dp"
            android:layout_marginHorizontal="55dp"/>

        <SeekBar
            android:id="@+id/option_first_three_bar_sb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="60dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="60dp"/>

</LinearLayout>